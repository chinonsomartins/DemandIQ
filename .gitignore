# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Secrets and local config (NEVER commit) ----
.env
*.pem
*.key
kaggle.json

# ---- Data: keep folder skeleton, ignore contents ----
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ---- Model outputs and experiment tracking ----
artifacts/*
!artifacts/.gitkeep
mlruns/

# ---- Editor and OS ----
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db